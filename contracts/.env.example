# Copy this file to .env and fill in real values. .env is gitignored, never
# commit it. Never commit or share the raw private key.

# Base Sepolia RPC URL, for example from Alchemy, Infura, or a public
# endpoint like https://sepolia.base.org.
BASE_SEPOLIA_RPC_URL=

# Private key of a Base Sepolia deployer account, funded with Base Sepolia
# test ETH (get some from a Base Sepolia faucet). 0x-prefixed hex.
PRIVATE_KEY=

# Optional, only needed to verify the deployed contracts on Basescan.
BASESCAN_API_KEY=
