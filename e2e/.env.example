# Copy this file to .env and fill in real values. .env is gitignored, never
# commit it. Never commit or share raw private keys.

BASE_SEPOLIA_RPC_URL=

# Two distinct funded Base Sepolia accounts, one per player. 0x-prefixed hex.
# Each needs a small amount of Base Sepolia test ETH to cover Inco op fees
# and gas, a few hundredths of a cent worth is plenty for one match.
PLAYER_A_PRIVATE_KEY=
PLAYER_B_PRIVATE_KEY=

# Set after running contracts/script/deploy.sh, or paste from
# contracts/deployments/baseSepolia.json.
CIPHERTIDE_ADDRESS=
