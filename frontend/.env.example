# Comma separated list of Base Sepolia RPC URLs
VITE_BASE_SEPOLIA_RPC_URL=

# Deployed Ciphertide address, see contracts/deployments/baseSepolia.json.
VITE_CIPHERTIDE_ADDRESS=

# Dev-only test signers for the throwaway dev harness (see
# src/dev/harness.tsx), the same two funded accounts e2e/.env uses. Never
# used by the real signer flow, which takes any viem WalletClient
# (browser wallet, sponsor layer, and so on) instead. Never commit real
# values here, this file is gitignored once copied to .env.
VITE_PLAYER_A_PRIVATE_KEY=
VITE_PLAYER_B_PRIVATE_KEY=
