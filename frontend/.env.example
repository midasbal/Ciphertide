# Comma separated list of Base Sepolia RPC URLs
VITE_BASE_SEPOLIA_RPC_URL=

# Deployed Ciphertide address, see contracts/deployments/baseSepolia.json.
# Optional: src/lib/contractAddress.ts carries the current deployed
# address as a committed default (it is public, not a secret), this only
# needs a value to override that default after a future redeploy.
VITE_CIPHERTIDE_ADDRESS=

# Dev-only test signers for the throwaway dev harness (see
# src/dev/harness.tsx) and the ?dev-signer=a/b override in
# src/lib/signer.ts, the same two funded accounts e2e/.env uses. Never
# used by the real signer flow, which reads the play-wallet from
# localStorage instead (see src/lib/playWallet.ts). Never commit real
# values here, this file is gitignored once copied to .env.
VITE_PLAYER_A_PRIVATE_KEY=
VITE_PLAYER_B_PRIVATE_KEY=

# Server-side only, read from process.env by server/fundHandler.ts, never
# by client code (no VITE_ prefix, so Vite never inlines it into the
# client bundle). The sponsor wallet that pays for new play-wallets'
# first 0.005 Base Sepolia ETH. NEVER commit a real value here. For local
# testing this can point at one of the two dev keys above, a distinct
# funded account for a real deploy.
SPONSOR_PRIVATE_KEY=

# The sponsor wallet stops paying out once its own balance falls to or
# below this floor, the stateless hard cap on total sponsor loss.
SPONSOR_FLOOR_ETH=0.02
